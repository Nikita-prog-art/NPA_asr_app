// Application icon.  npa_asr.ico is generated at build time by tools/make_icon
// (see CMakeLists.txt) from the same drawing code the window icon and the
// notification-area icon use, so the three cannot drift apart.  Resource id 1
// is the icon Explorer, the taskbar and Alt-Tab pick up.
1 ICON "@ASR_APP_ICON_RC@"

// Windows application manifest (DPI awareness, supported OS versions,
// asInvoker).  Configured so that the manifest path is absolute: the resource
// compiler resolves relative paths against its own working directory.
// CREATEPROCESS_MANIFEST_RESOURCE_ID (1), RT_MANIFEST (24).  Empty when the
// linker merges the manifest instead (MSVC, see CMakeLists.txt).
@ASR_RC_MANIFEST@
